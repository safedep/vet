# An inline node script that builds a payload from char codes
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "node -e \"eval(String.fromCharCode(99,111,110,115,111,108,101))\"",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
