# vet state delete counts the scans in the singular and in the plural. It
# shows the table before it asks, and prints one line when no scan matches.
cd proj
exec vet scan . --mode plain -o plain
exec vet state delete --all --dry-run --mode plain
stderr 'vet would delete 1 scan and the enrichment cache \('

execexit 2 vet state delete --all --mode rich
stdout 'SCAN'
stderr 'cannot ask "Delete 1 scan and the enrichment cache \('

exec vet state delete --all --yes --mode plain
stderr 'Deleted 1 scan and the enrichment cache \('

exec vet state delete --scan nomatch --mode plain
stderr -count=1 'No scan to delete\.'
! stderr 'Nothing to delete'

-- proj/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"left-pad": "1.3.0"}}, "node_modules/left-pad": {"version": "1.3.0", "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"}}}
