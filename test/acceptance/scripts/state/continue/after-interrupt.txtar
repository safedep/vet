[!unix] skip 'signals are unix only'
# After SIGINT, vet saves the progress. The next vet scan continues the same
# scan id and completes it. It says so before the first step.
cd proj
stub delay 3s
! exec vet scan . --mode plain -o plain --no-cache &scan&
sleep 1s
kill -INT scan
wait scan
stderr 'Saved the progress of scan'
capture ID 'Saved the progress of scan ([0-9a-f]+)\.' stderr

stub delay 0s
exec vet scan . --mode plain -o json --no-cache
stderr '(?s)continued scan '$ID' from where it stopped.*\[INFO\] Read the manifests'
jsonq stdout header.scan.id $ID
jsonq stdout header.scan.continued true

-- proj/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"left-pad": "1.3.0"}}, "node_modules/left-pad": {"version": "1.3.0", "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"}}}
