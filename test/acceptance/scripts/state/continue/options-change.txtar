[!unix] skip 'signals are unix only'
# With other scan options, vet starts a new scan and prints the reason.
cd proj
stub delay 3s
! exec vet scan . --mode plain -o plain --no-cache &scan&
sleep 1s
kill -INT scan
wait scan
stub delay 0s
exec vet scan . --mode plain -o plain --exclude vendor
stderr 'Started a new scan. vet did not continue scan [0-9a-f]+, because the scan options changed'

