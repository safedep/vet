# A second scan within the cache time to live makes no enrichment call.
# --no-cache makes the calls again.
cd proj
exec vet scan . --mode plain -o plain
stub calls insights 1
exec vet scan . --mode plain -o plain --fresh
stub calls insights 1
exec vet scan . --mode plain -o plain --fresh --no-cache
stub calls insights 2

