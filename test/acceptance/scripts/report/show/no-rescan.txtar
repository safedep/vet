# vet report show renders the last scan from the scan file. It works with
# the stub server stopped, so it makes no new scan.
cd proj
exec vet scan . --mode plain -o plain
stub stop
exec vet report show last --mode plain -o json --report sarif=$WORK/vet.sarif
reportcheck stdout
stdout '"control_id":"malware"'
jsonq $WORK/vet.sarif version 2.1.0

exec vet report show --mode plain -o plain
stdout 'malware\tpkg:npm/safedep-test-pkg@0.1.3'

cd $WORK
execexit 2 vet report show --mode plain
stderr 'usage_no_scan'
execexit 2 vet report show nosuchid --mode plain
stderr 'usage_no_scan'

-- proj/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3"}}, "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"}}}
