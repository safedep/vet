# vet report list shows each scan of the target with its status, counts
# and gate. --all shows every target.
cd a
exec vet scan . --mode plain -o plain
execexit 1 vet scan . --mode plain -o plain --fail-on critical
exec vet report list --mode plain -o json
jsonq stdout len 2
jsonq stdout 0.status completed
jsonq stdout 0.gate FAIL
jsonq stdout 0.findings 1
jsonq stdout 1.gate NONE

cd ../b
exec vet scan . --mode plain -o plain
exec vet report list --mode plain -o json
jsonq stdout len 1
exec vet report list --all --mode plain -o plain
stdout 'SCAN\tTARGET'
exec vet report list --all --mode plain -o json
jsonq stdout len 3

-- a/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3"}}, "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"}}}
