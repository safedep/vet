# vet endpoint audit checks the entry scripts of the global npm. PolinRider
# overwrites npm/lib/cli.js with about 1 MB, so each npm command starts the
# malware again.
execexit 1 vet endpoint audit --mode plain -o json --fail-on attacks
stdout '"control_id":"padded-code","family":"hidden-code","severity":"critical"'
stdout '"path":"[^"]*node_modules/npm/lib/cli.js"'

-- home/.npm-global/lib/node_modules/npm/package.json --
{"name": "npm", "version": "10.9.0"}
-- home/.npm-global/lib/node_modules/npm/lib/cli.js --
module.exports = require('./cli-entry.js')
