# vet fix github-actions run leaves a workflow that the GitHub Actions
# lockfile lists, and names gh actions-lock. A new SHA there has no entry,
# and GitHub fails the run. A workflow that the lockfile does not list gets
# its pins.
env VET_PLUGINS_WORKFLOW_OPTIONS_TRUST_ACTIONS_LOCK=true
exec vet fix github-actions run --mode plain
stderr 'The GitHub Actions lockfile locks the actions of 1 file'
stderr 'gh actions-lock'
stderr 'Pinned 1 action in 1 file\.'
cmp .github/workflows/ci.yml $WORK/ci.yml
grep 'actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4' .github/workflows/other.yml
stub calls github 1

-- .github/workflows/ci.yml --
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
-- ci.yml --
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
-- .github/workflows/other.yml --
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
-- .github/workflows/actions.lock --
version: 'v0.0.3'
workflows:
    '.github/workflows/ci.yml':
        - 'actions/checkout@v4'
dependencies:
    'actions/checkout@v4':
        ref: 'v4'
        commit: 'sha1-11bd71901bbe5b1630ceea73d27597364c9af683'
        owner_id: 44036562
        repo_id: 197814629
