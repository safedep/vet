# vet fix github-actions run pins each third-party action that uses a tag
# to a commit SHA from the stub GitHub API, with the tag in a comment.
# Local actions and pinned actions do not change.
exec vet fix github-actions run --mode plain
stderr 'Pinned 2 actions in 1 file\.'
cmp .github/workflows/ci.yml $WORK/want.yml
stub calls github 2

exec vet scan . --mode plain -o plain
! stdout 'unpinned-action'

-- .github/workflows/ci.yml --
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/local
      - uses: actions/checkout@v4.2.2  # pinned for the release
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
-- want.yml --
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4
      - uses: ./.github/actions/local
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2; pinned for the release
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
