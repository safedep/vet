# After a scan with findings, a person sees a gate line that names the gate,
# then the commands that list the findings and show one. vet report show
# does not name itself. The agent mode gets no such line.
cd proj
execexit 1 vet scan . --mode plain -o plain --fail-on high
stderr 'Gate failed: 1 finding at high or above \(--fail-on high\)$'
stderr 'Full list: vet report show [0-9a-f]{8} --all$'
stderr 'One finding: vet report finding show f-[0-9a-f]+$'
! stderr '-o json'

execexit 1 vet report show --mode plain -o plain --fail-on high
stderr 'One finding: vet report finding show f-[0-9a-f]+$'
! stderr 'Full list'

execexit 1 vet scan . --mode agent -o json --fail-on high
! stderr 'One finding'

-- proj/package-lock.json --
{
  "name": "app",
  "lockfileVersion": 3,
  "packages": {
    "": {"name": "app", "dependencies": {"left-pad": "1.3.0"}},
    "node_modules/left-pad": {"version": "1.3.0", "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"}
  }
}
