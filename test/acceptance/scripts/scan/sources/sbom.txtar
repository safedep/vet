# vet scan reads a CycloneDX and an SPDX file.
exec vet scan bom.cdx.json --mode plain -o json
stdout '"purl":"pkg:npm/safedep-test-pkg@0.1.3"'
stdout '"control_id":"malware"'
exec vet scan bom.spdx.json --mode plain -o json
stdout '"purl":"pkg:npm/left-pad@1.3.0"'

-- bom.cdx.json --
{
  "bomFormat": "CycloneDX",
  "specVersion": "1.5",
  "version": 1,
  "components": [
    {"type": "library", "name": "safedep-test-pkg", "version": "0.1.3", "purl": "pkg:npm/safedep-test-pkg@0.1.3"}
  ]
}
-- bom.spdx.json --
{
  "spdxVersion": "SPDX-2.3",
  "dataLicense": "CC0-1.0",
  "SPDXID": "SPDXRef-DOCUMENT",
  "name": "app",
  "documentNamespace": "https://example.com/app",
  "creationInfo": {"created": "2026-01-01T00:00:00Z", "creators": ["Tool: test"]},
  "packages": [
    {
      "SPDXID": "SPDXRef-left-pad",
      "name": "left-pad",
      "versionInfo": "1.3.0",
      "downloadLocation": "NOASSERTION",
      "externalRefs": [{"referenceCategory": "PACKAGE-MANAGER", "referenceType": "purl", "referenceLocator": "pkg:npm/left-pad@1.3.0"}]
    }
  ]
}
