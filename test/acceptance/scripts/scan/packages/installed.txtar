# --packages selects where vet finds packages. A directory scan reads the
# lockfile and does not walk node_modules by default. installed reads the
# packages on disk. all reads both, and reports an installed package that the
# lockfile does not list. Each selection reads the workflows. A default scan
# names the installed packages that it did not read. A policy tells the two
# origins apart with package.origin.
cd proj
exec vet scan . --mode plain -o jsonl
stdout '"raw_name":"left-pad"'
! stdout '"raw_name":"minimist"'
! stdout '"kind":"installed"'
stderr 'The installed packages in .+ are not in the scan'

exec vet scan . --mode plain -o jsonl --fresh --packages declared
! stderr 'are not in the scan'

exec vet scan . --mode plain -o jsonl --fresh --packages installed
stdout '"raw_name":"minimist"'
stdout '"raw_name":"python-dateutil"'
stdout '"kind":"installed"'
! stdout '"kind":"lockfile"'
! stdout '"raw_name":"app"'
! stdout '"raw_name":"fixture"'
stdout '"path":".github/workflows/ci.yml","ecosystem":"github-actions","kind":"workflow"'

exec vet scan . --mode plain -o jsonl --fresh --packages all
stdout '"kind":"lockfile"'
stdout '"kind":"installed"'
stdout '"control_id":"installed-not-locked".*"raw_name":"minimist"'
! stdout '"control_id":"installed-not-locked".*"raw_name":"left-pad"'

execexit 1 vet scan . --mode plain -o plain --packages all --policy $WORK/installed.yml
stderr 'policy rule installed-only'
exec vet scan . --mode plain -o plain --packages all --policy $WORK/declared.yml
! stderr 'policy rule declared-only'

execexit 2 vet scan . --packages everything
stderr 'not valid'

-- installed.yml --
version: 2
rules:
  - id: installed-only
    when: finding.control_id == "installed-not-locked" && package.origin == "installed"
    action: fail
-- declared.yml --
version: 2
rules:
  - id: declared-only
    when: finding.control_id == "installed-not-locked" && package.origin == "declared"
    action: fail
-- proj/.github/workflows/ci.yml --
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
-- proj/package.json --
{"name": "app", "version": "1.0.0", "dependencies": {"left-pad": "1.3.0"}}
-- proj/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"left-pad": "1.3.0"}}, "node_modules/left-pad": {"version": "1.3.0", "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"}}}
-- proj/node_modules/left-pad/package.json --
{"name": "left-pad", "version": "1.3.0"}
-- proj/node_modules/minimist/package.json --
{"name": "minimist", "version": "1.2.0"}
-- proj/node_modules/minimist/test/fixture/package.json --
{"name": "fixture", "version": "0.0.1"}
-- proj/.venv/lib/python3.12/site-packages/python_dateutil-2.8.0.dist-info/METADATA --
Metadata-Version: 2.1
Name: python-dateutil
Version: 2.8.0
