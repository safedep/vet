# In pull request mode, a yarn.lock entry that keeps its version and its
# hash, and moves its download to another host, is a modified package. It
# gives untrusted-registry, so the gate sees the attack.
[!git] skip 'needs git'
cd repo
exec git -c user.email=t@example.com -c user.name=t init -q
exec git -c user.email=t@example.com -c user.name=t add -A
exec git -c user.email=t@example.com -c user.name=t commit -q -m base
replace yarn.lock https://registry.yarnpkg.com/left-pad/-/ https://evil.example.com/
exec vet scan . --base-ref HEAD --mode plain -o json
stdout '"control_id":"untrusted-registry"'
stdout '"change":"MODIFIED"'

-- repo/package.json --
{"name": "app", "version": "1.0.0", "dependencies": {"left-pad": "1.3.0"}}
-- repo/yarn.lock --
# THIS IS AN AUTOGENERATED FILE. DO NOT EDIT THIS FILE DIRECTLY.
# yarn lockfile v1


left-pad@1.3.0:
  version "1.3.0"
  resolved "https://registry.yarnpkg.com/left-pad/-/left-pad-1.3.0.tgz#5b8a3a7765dfe001261dde915589e782f8c94d1e"
  integrity sha512-XI5MPzVNApjAyhQzphX8BkmKsKUxD4LdyK24iZeQEhyBcXrhPgCs4hdEPvuWwd8sTW2lrXqqXR6KyuSH2xYbGQ==
