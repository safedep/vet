# The tenant-id input of the action selects the workload identity of the
# job. action/scan.sh gives SAFEDEP_TENANT_ID to vet with SAFEDEP_API_KEY
# unset, also when the job maps a missing secret to an empty
# SAFEDEP_API_KEY. vet exchanges one ID token, enriches with the workload
# credential and revokes it. Later steps do not get the variables.
[!exec:bash] skip 'needs bash'
[!exec:jq] skip 'needs jq'
[windows] skip 'the action tests run scan.sh on Windows'
env GITHUB_ACTIONS=true
env GITHUB_REPOSITORY=acme/web
env GITHUB_EVENT_NAME=push
env GITHUB_EVENT_PATH=$WORK/event.json
env GITHUB_OUTPUT=$WORK/output.txt
env GITHUB_ENV=$WORK/github-env.txt
env RUNNER_TEMP=$WORK/runner
env GH_TOKEN=ghs_test
env ACTION_FAIL_ON=none
env ACTION_COMMENT=never
env 'ACTION_ARGS=--mode plain'
env ACTION_TENANT_ID=acme.safedep.io
env SAFEDEP_API_KEY=
env ACTIONS_ID_TOKEN_REQUEST_URL=$STUB_ID_TOKEN_URL
env ACTIONS_ID_TOKEN_REQUEST_TOKEN=$STUB_ID_TOKEN_REQUEST_TOKEN
env SAFEDEP_CLOUD_DATA_ADDR=$STUB_ADDR
env INSECURE_GRPC_CLIENT_USE_INSECURE_TRANSPORT=true
cp $WORK/empty.txt $WORK/output.txt
cp $WORK/empty.txt $WORK/github-env.txt
mkdir $WORK/runner
cd repo
exec bash $VET_SRC/action/scan.sh
grep '^findings=1$' $WORK/output.txt
stub calls exchange 1
! stub calls workload 0
stub calls revoke 1
! grep SAFEDEP $WORK/github-env.txt

-- empty.txt --
-- event.json --
{}
-- repo/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3"}}, "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"}}}
