# A pull request from a fork gets no ID token. With the tenant-id input,
# action/scan.sh warns, and vet runs with no SafeDep Cloud credential. It
# does not read the keychain login of the job user either, so no request
# to the stub carries a credential.
[!git] skip 'needs git'
[!exec:bash] skip 'needs bash'
[!exec:jq] skip 'needs jq'
[windows] skip 'the action tests run scan.sh on Windows'
stdin key.txt
exec vet auth login --api-key-stdin --tenant acme.safedep.io
exec vet auth status -o json
jsonq stdout tenant acme.safedep.io

env GITHUB_ACTIONS=true
env GITHUB_REPOSITORY=acme/app
env GITHUB_EVENT_NAME=pull_request
env GITHUB_EVENT_PATH=$WORK/event.json
env GITHUB_OUTPUT=$WORK/output.txt
env RUNNER_TEMP=$WORK/runner
env GH_TOKEN=ghs_test
env ACTION_FAIL_ON=none
env ACTION_COMMENT=never
env 'ACTION_ARGS=--mode plain'
env ACTION_TENANT_ID=acme.safedep.io
cp $WORK/empty.txt $WORK/output.txt
mkdir $WORK/runner
cd repo
exec git -c user.email=t@example.com -c user.name=t init -q
exec git -c user.email=t@example.com -c user.name=t add -A
exec git -c user.email=t@example.com -c user.name=t commit -q -m base
exec bash -c 'printf ''{"pull_request": {"number": 1, "base": {"sha": "%s"}, "head": {"sha": "2222222222222222222222222222222222222222", "repo": {"full_name": "someone/app"}}}}'' "$(git rev-parse HEAD)" >"$GITHUB_EVENT_PATH"'
cp $WORK/change-lock.json package-lock.json
exec bash $VET_SRC/action/scan.sh
stdout '::warning::GitHub gives no ID token to a pull request from a fork'
grep '^gate=none$' $WORK/output.txt
! stub calls insights 0
stub calls authenticated 0
stub calls exchange 0

-- empty.txt --
-- key.txt --
sk_from_keychain
-- repo/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app"}}}
-- change-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3"}}, "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"}}}
