# When SafeDep Cloud refuses the workload identity exchange, the scan
# completes with one diagnostic that gives the reason. The scan makes no
# other call to SafeDep Cloud, so the malware control has no data, and no
# enrichment call fails with the same error.
cd proj
env SAFEDEP_TENANT_ID=acme.safedep.io
env ACTIONS_ID_TOKEN_REQUEST_URL=$STUB_ID_TOKEN_URL
env ACTIONS_ID_TOKEN_REQUEST_TOKEN=$STUB_ID_TOKEN_REQUEST_TOKEN
env SAFEDEP_CLOUD_DATA_ADDR=$STUB_ADDR
env INSECURE_GRPC_CLIENT_USE_INSECURE_TRANSPORT=true
stub fail exchange PermissionDenied
exec vet scan . --mode plain -o json
jsonq stdout trailer.gate.outcome NONE
jsonq stdout trailer.summary.diagnostics 1
stdout '"code":"workload_exchange_failed"'
stdout 'acme.safedep.io'
stdout 'PermissionDenied'
! stdout '"control_id":"malware"'
stub calls exchange 1
stub calls insights 0
stub calls malysis 0
stub calls revoke 0

# --strict counts the diagnostic and exits 3.
execexit 3 vet scan . --mode plain --strict
stderr 'credentials: vet did not get a SafeDep Cloud credential'

-- proj/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3"}}, "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"}}}
