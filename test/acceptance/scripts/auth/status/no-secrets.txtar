# vet auth status never prints a secret. The table shows the last 4
# characters of the key. The JSON shows no part of it.
stdin key.txt
exec vet auth login --api-key-stdin --tenant acme.safedep.io
stderr 'Signed in to acme.safedep.io on profile "default"'

exec vet auth status -o json
jsonq stdout profile default
jsonq stdout tenant acme.safedep.io
! stdout sk_test_secret

exec vet auth status --mode plain -o table
stdout '••••1234'
! stdout sk_test_secret

exec vet auth logout
stderr 'Signed out of profile "default"'
exec vet auth status -o json
! stdout api_key_source
! stdout acme.safedep.io

-- key.txt --
sk_test_secret_1234
