# A bare policy name finds the file that vet policy init wrote in the
# config directory: vet policy validate, vet scan --policy and vet report
# show --policy accept it. A file of that name in the current directory
# wins.
exec vet policy init --mode plain
stderr 'vet scan --policy default applies it'
exec vet policy validate default --mode plain -o json
jsonq stdout rules 4

cd proj
execexit 1 vet scan . --mode plain -o plain --policy default
stderr 'policy rule no-malware'
execexit 1 vet report show --mode plain -o plain --policy default
stderr 'policy rule no-malware'

cp $WORK/local.yml default
exec vet policy validate default --mode plain -o json
jsonq stdout rules 1

-- local.yml --
version: 2
rules:
  - id: local-only
    when: finding.severity == "critical"
    action: warn
-- proj/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3"}}, "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"}}}
