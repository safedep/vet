# An invalid policy file gives exit 2 and names the error. A valid file
# exits 0. A YAML error names the file and the line, and no Go type.
execexit 2 vet policy validate bad.yml --mode plain
stderr 'policy_invalid'
stderr 'rules\[0\]: action is "block"'
stderr 'suppressions\[0\]: reason is empty'

execexit 2 vet scan proj --mode plain --policy bad.yml
stderr 'policy_invalid'

execexit 2 vet policy validate unknown.yml --mode plain
stderr -count=1 'policy_invalid'
stderr 'unknown.yml line 4: "fail" is not a field of a rule. A rule has id, description, when, action, help, link and severity.'
! stderr 'policy\.Rule'

exec vet policy validate good.yml --mode plain -o json
jsonq stdout rules 1

execexit 2 vet policy validate missing.yml --mode plain
stderr 'policy_invalid'

-- bad.yml --
version: 2
rules:
  - id: r1
    when: finding.severity == "critical"
    action: block
suppressions:
  - control: malware
-- unknown.yml --
version: 2
rules:
  - id: r1
    fail: true
    when: finding.severity == "critical"
    action: fail
-- good.yml --
version: 2
rules:
  - id: r1
    when: package.days_since_publish < 5
    action: warn
-- proj/requirements.txt --
requests==2.31.0
