# A plain scan of a project with a malicious package reports the finding,
# prints no gate line and exits 0.
cd proj
exec vet scan . --mode plain -o plain
stdout 'malware\tpkg:npm/safedep-test-pkg@0.1.3'
! stderr 'Gate'
stderr 'No gate set, so vet exits 0'

-- proj/package-lock.json --
{
  "name": "app",
  "lockfileVersion": 3,
  "packages": {
    "": {"name": "app", "dependencies": {"safedep-test-pkg": "0.1.3","lodash": "4.17.21"}},
    "node_modules/safedep-test-pkg": {"version": "0.1.3", "resolved": "https://registry.npmjs.org/safedep-test-pkg/-/safedep-test-pkg-0.1.3.tgz"},
    "node_modules/lodash": {"version": "4.17.21", "resolved": "https://registry.npmjs.org/lodash/-/lodash-4.17.21.tgz"}
  }
}
