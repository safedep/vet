# vet doctor exits 0 on a fresh sandbox, and -o json lists each check with
# an id. A stopped endpoint fails a check and exits 1. The text output is
# one line for each check, with a fix line under a check that failed.
exec vet doctor --mode plain -o json
jsonq stdout 0.id vet.version
stdout '"id": "state.index"'
stdout '"id": "endpoint.insights",\s+"status": "pass"'
! stdout '"status": "fail"'

stub fail malysis Unavailable
execexit 1 vet doctor --mode plain -o plain
stdout '^\[ERR\]\s+endpoint\.malysis\s+malysis did not answer'
stdout '^\s+> Check the network'
stdout '^\[OK\]\s+state\.size\s+0 scans use 0 B'
