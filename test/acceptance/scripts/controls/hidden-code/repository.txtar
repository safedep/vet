# A repository in the shape of a PolinRider infection: a build config with
# code after a run of spaces and a PolinRider marker, a fake font with
# leading tabs, a .gitignore that hides the push script, and a payload in
# variation selectors with a decoder. Each one fails the attacks gate. The
# snippet of the build config shows no payload. A clean config and a real
# font give no finding.
cd repo
execexit 1 vet scan . --mode plain -o json --fail-on attacks
stdout '"control_id":"padded-code","family":"hidden-code","severity":"critical"'
stdout 'It matches PolinRider'
stdout '"snippet":"export default config;"'
! stdout 'global\[.._V'
stdout '"control_id":"disguised-script"'
stdout '"path":"public/fonts/fa-solid-400.woff2"'
stdout '"control_id":"history-rewrite-script"'
stdout '"control_id":"unicode-decoder"'
! stdout 'next.config.js'
! stdout 'real.woff2'

