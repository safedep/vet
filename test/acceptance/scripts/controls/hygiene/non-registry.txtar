# A package.json dependency on git, a file or any version gives
# non-registry-dependency on the line of the dependency.
exec vet scan . --mode plain -o json
stdout '"control_id":"non-registry-dependency"'
stdout '"title":"mylib comes from github:me/mylib"'
stdout '"title":"anything comes from any version'

-- package.json --
{
  "name": "app",
  "dependencies": {
    "left-pad": "1.3.0",
    "mylib": "github:me/mylib",
    "anything": "*"
  }
}
-- package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app"}, "node_modules/left-pad": {"version": "1.3.0", "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz"}}}
