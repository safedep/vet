# In pull request mode, a lockfile entry that keeps its version and changes
# its integrity hash gives integrity-changed, and a lockfile change with no
# package.json change gives lockfile-only-change.
[!git] skip 'needs git'
cd repo
exec git -c user.email=t@example.com -c user.name=t init -q
exec git -c user.email=t@example.com -c user.name=t add -A
exec git -c user.email=t@example.com -c user.name=t commit -q -m base
replace package-lock.json sha512-good sha512-evil
exec vet scan . --base-ref HEAD --mode plain -o json
stdout '"control_id":"integrity-changed"'
stdout '"control_id":"lockfile-only-change"'

-- repo/package.json --
{"name": "app", "dependencies": {"left-pad": "1.3.0"}}
-- repo/package-lock.json --
{"name": "app", "lockfileVersion": 3, "packages": {"": {"name": "app", "dependencies": {"left-pad": "1.3.0"}}, "node_modules/left-pad": {"version": "1.3.0", "resolved": "https://registry.npmjs.org/left-pad/-/left-pad-1.3.0.tgz", "integrity": "sha512-good"}}}
