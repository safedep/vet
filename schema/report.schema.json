{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.safedep.io/vet/report/v1/report.schema.json",
  "$ref": "#/$defs/Document",
  "$defs": {
    "ActionCommit": {
      "properties": {
        "reachable": {
          "type": "boolean"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ref": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "reachable"
      ]
    },
    "ApplicationSubject": {
      "properties": {
        "root": {
          "type": "string"
        },
        "signature_id": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "root"
      ]
    },
    "Attack": {
      "properties": {
        "technique": {
          "type": "string"
        },
        "mitre": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CallSite": {
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "callee": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "file",
        "line",
        "callee"
      ]
    },
    "Capability": {
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        },
        "occurrences": {
          "items": {
            "$ref": "#/$defs/Occurrence"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "id",
        "occurrences"
      ]
    },
    "Diagnostic": {
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        }
      },
      "type": "object",
      "required": [
        "level",
        "code",
        "component",
        "message"
      ]
    },
    "Document": {
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/Record"
          },
          "type": "array"
        },
        "trailer": {
          "$ref": "#/$defs/Trailer"
        }
      },
      "type": "object",
      "required": [
        "header",
        "records",
        "trailer"
      ]
    },
    "DynamicSite": {
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "file",
        "line",
        "kind"
      ]
    },
    "EntryPoint": {
      "properties": {
        "function": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "function",
        "kind"
      ]
    },
    "Evidence": {
      "properties": {
        "source": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "source",
        "summary"
      ]
    },
    "FileSubject": {
      "properties": {
        "path": {
          "type": "string"
        },
        "element": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "path"
      ]
    },
    "Finding": {
      "properties": {
        "id": {
          "type": "string"
        },
        "control_id": {
          "type": "string"
        },
        "family": {
          "type": "string",
          "enum": [
            "malware",
            "vulnerability",
            "cooldown",
            "workflow",
            "lockfile",
            "agent-config",
            "hidden-code",
            "ai-bom",
            "license",
            "hygiene",
            "reputation",
            "policy"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "locus": {
          "$ref": "#/$defs/Locus"
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remediation": {
          "$ref": "#/$defs/Remediation"
        },
        "suppression": {
          "$ref": "#/$defs/Suppression"
        },
        "gate": {
          "$ref": "#/$defs/GateRecord"
        },
        "attack": {
          "$ref": "#/$defs/Attack"
        },
        "advisory": {
          "type": "string"
        },
        "reach": {
          "$ref": "#/$defs/Reach"
        }
      },
      "type": "object",
      "required": [
        "id",
        "control_id",
        "family",
        "severity",
        "confidence",
        "subject",
        "title",
        "description"
      ]
    },
    "FunctionReach": {
      "properties": {
        "status": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/PathHop"
          },
          "type": "array"
        },
        "test_only": {
          "type": "boolean"
        }
      },
      "type": "object",
      "required": [
        "status"
      ]
    },
    "Gate": {
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "NONE",
            "PASS",
            "FAIL"
          ]
        },
        "fail_on": {
          "type": "string",
          "enum": [
            "attacks",
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "policy": {
          "type": "string"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy_changed": {
          "type": "boolean"
        }
      },
      "type": "object",
      "required": [
        "outcome"
      ]
    },
    "GateRecord": {
      "properties": {
        "action": {
          "type": "string"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "broken": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fail_on": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "action"
      ]
    },
    "Header": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/Tool"
        },
        "scan": {
          "$ref": "#/$defs/ScanInfo"
        }
      },
      "type": "object",
      "required": [
        "schema_version",
        "tool",
        "scan"
      ]
    },
    "ImportSite": {
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "file",
        "line"
      ]
    },
    "Insight": {
      "properties": {
        "vulnerabilities": {
          "items": {
            "$ref": "#/$defs/Vulnerability"
          },
          "type": "array"
        },
        "licenses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "deprecated": {
          "type": "boolean"
        },
        "scorecard": {
          "$ref": "#/$defs/Scorecard"
        },
        "source_repo": {
          "type": "string"
        },
        "downloads": {
          "type": "integer"
        },
        "latest_version": {
          "type": "string"
        },
        "first_published_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "boolean"
        },
        "stars": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "InventoryItem": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ai-tool",
            "mcp-server",
            "skill",
            "editor-plugin"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object",
      "required": [
        "kind",
        "name"
      ]
    },
    "Locus": {
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer"
        },
        "end_line": {
          "type": "integer"
        },
        "snippet": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "path"
      ]
    },
    "MalwareAnalysis": {
      "properties": {
        "malicious": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "report_url": {
          "type": "string"
        },
        "analysis_id": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "malicious",
        "verified"
      ]
    },
    "Manifest": {
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string",
          "enum": [
            "cargo",
            "github-actions",
            "go",
            "maven",
            "npm",
            "nuget",
            "openvsx",
            "packagist",
            "pub",
            "pypi",
            "rubygems",
            "terraform-provider",
            "vscode"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "lockfile",
            "manifest",
            "workflow",
            "sbom",
            "image",
            "purl",
            "endpoint",
            "agent-config",
            "file",
            "installed"
          ]
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        },
        "lockfile_only": {
          "type": "boolean"
        },
        "extractor": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "id",
        "path",
        "kind"
      ]
    },
    "ManifestSubject": {
      "properties": {
        "path": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string",
          "enum": [
            "cargo",
            "github-actions",
            "go",
            "maven",
            "npm",
            "nuget",
            "openvsx",
            "packagist",
            "pub",
            "pypi",
            "rubygems",
            "terraform-provider",
            "vscode"
          ]
        }
      },
      "type": "object",
      "required": [
        "path"
      ]
    },
    "Occurrence": {
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "callee": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "file"
      ]
    },
    "PackageEntry": {
      "properties": {
        "purl": {
          "type": "string"
        },
        "manifest_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uses": {
          "items": {
            "$ref": "#/$defs/PackageUse"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PackageVersion"
        },
        "direct": {
          "type": "boolean"
        },
        "dev": {
          "type": "boolean"
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        },
        "previous_version": {
          "type": "string"
        },
        "previous_resolved": {
          "type": "string"
        },
        "previous_integrity": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "resolved": {
          "type": "string"
        },
        "integrity": {
          "type": "string"
        },
        "local": {
          "type": "boolean"
        },
        "insight": {
          "$ref": "#/$defs/Insight"
        },
        "malware": {
          "$ref": "#/$defs/MalwareAnalysis"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "action": {
          "$ref": "#/$defs/ActionCommit"
        },
        "previous_insight": {
          "$ref": "#/$defs/Insight"
        }
      },
      "type": "object",
      "required": [
        "purl",
        "manifest_ids",
        "id",
        "direct"
      ]
    },
    "PackageSubject": {
      "properties": {
        "purl": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string",
          "enum": [
            "cargo",
            "github-actions",
            "go",
            "maven",
            "npm",
            "nuget",
            "openvsx",
            "packagist",
            "pub",
            "pypi",
            "rubygems",
            "terraform-provider",
            "vscode"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "raw_name": {
          "type": "string"
        },
        "raw_version": {
          "type": "string"
        },
        "direct": {
          "type": "boolean"
        },
        "manifest_path": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "purl",
        "ecosystem",
        "name",
        "raw_name",
        "direct",
        "manifest_path"
      ]
    },
    "PackageUse": {
      "properties": {
        "manifest_id": {
          "type": "string"
        },
        "direct": {
          "type": "boolean"
        },
        "dev": {
          "type": "boolean"
        },
        "change": {
          "type": "string",
          "enum": [
            "",
            "ADDED",
            "UPGRADED",
            "DOWNGRADED",
            "MODIFIED",
            "REMOVED",
            "UNCHANGED"
          ]
        },
        "previous_version": {
          "type": "string"
        },
        "resolved": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "manifest_id",
        "direct"
      ]
    },
    "PackageVersion": {
      "properties": {
        "ecosystem": {
          "type": "string",
          "enum": [
            "cargo",
            "github-actions",
            "go",
            "maven",
            "npm",
            "nuget",
            "openvsx",
            "packagist",
            "pub",
            "pypi",
            "rubygems",
            "terraform-provider",
            "vscode"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "raw_name": {
          "type": "string"
        },
        "raw_version": {
          "type": "string"
        },
        "purl": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "ecosystem",
        "name",
        "raw_name"
      ]
    },
    "PathHop": {
      "properties": {
        "function": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "root": {
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "function"
      ]
    },
    "Reach": {
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "called",
            "not-called",
            "imported",
            "unused",
            "unknown"
          ]
        },
        "cause": {
          "type": "string",
          "enum": [
            "no-graph",
            "dynamic-import",
            "budget",
            "unread-files",
            "no-source-files",
            "no-symbol-data",
            "no-entry-point",
            "no-dependency-source",
            "no-symbol-in-graph",
            "broad-record",
            "unreviewed-record",
            "unresolved-call",
            "dynamic-flag",
            "transitive",
            "analysis-failed",
            "unproven-language",
            "weak-path"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "via": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "test_only": {
          "type": "boolean"
        },
        "imports": {
          "items": {
            "$ref": "#/$defs/ImportSite"
          },
          "type": "array"
        },
        "fix_sites": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/PathHop"
          },
          "type": "array"
        },
        "symbols": {
          "$ref": "#/$defs/ReachSymbols"
        }
      },
      "type": "object",
      "required": [
        "level",
        "confidence"
      ]
    },
    "ReachInfo": {
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "off",
            "import",
            "function"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "computed",
            "off",
            "no-source",
            "unavailable",
            "failed"
          ]
        },
        "symbol_data": {
          "type": "boolean"
        },
        "symbols": {
          "$ref": "#/$defs/SymbolBundle"
        },
        "roots": {
          "$ref": "#/$defs/ReachRoots"
        },
        "sources": {
          "$ref": "#/$defs/ReachSources"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object",
      "required": [
        "level",
        "status"
      ]
    },
    "ReachRoots": {
      "properties": {
        "fallback": {
          "type": "boolean"
        },
        "total": {
          "type": "integer"
        },
        "list": {
          "items": {
            "$ref": "#/$defs/EntryPoint"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "total"
      ]
    },
    "ReachSources": {
      "properties": {
        "found": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "found",
        "missing"
      ]
    },
    "ReachSymbols": {
      "properties": {
        "record": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "review": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
