{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "vet",
          "version": "test",
          "informationUri": "https://github.com/safedep/vet",
          "rules": [
            {
              "id": "dependency-cooldown",
              "shortDescription": {
                "text": "dependency-cooldown"
              },
              "properties": {
                "tags": [
                  "security",
                  "cooldown"
                ]
              }
            },
            {
              "id": "malware",
              "shortDescription": {
                "text": "malware"
              },
              "properties": {
                "tags": [
                  "security",
                  "malware",
                  "attack",
                  "external/mitre-attack/T1195.001"
                ]
              }
            },
            {
              "id": "unpinned-action",
              "shortDescription": {
                "text": "unpinned-action"
              },
              "properties": {
                "tags": [
                  "security",
                  "workflow"
                ]
              }
            },
            {
              "id": "vulnerability",
              "shortDescription": {
                "text": "vulnerability"
              },
              "properties": {
                "tags": [
                  "security",
                  "vulnerability"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "malware",
          "level": "error",
          "message": {
            "text": "Malicious package. The package runs a postinstall script that reads ~/.npmrc."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json"
                },
                "region": {
                  "startLine": 42,
                  "endLine": 42
                }
              }
            }
          ],
          "partialFingerprints": {
            "vetFindingId/v1": "f-f7017b227d6ad796"
          },
          "properties": {
            "security-severity": "9.5",
            "tags": [
              "critical",
              "malware",
              "attack",
              "external/mitre-attack/T1195.001"
            ]
          }
        },
        {
          "ruleId": "dependency-cooldown",
          "level": "error",
          "message": {
            "text": "Package version is inside the cooldown window"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json"
                }
              }
            }
          ],
          "partialFingerprints": {
            "vetFindingId/v1": "f-1badc134ad1d507f"
          },
          "suppressions": [
            {
              "kind": "external",
              "justification": "Reviewed"
            }
          ],
          "properties": {
            "security-severity": "8.0",
            "tags": [
              "high",
              "cooldown"
            ]
          }
        },
        {
          "ruleId": "vulnerability",
          "level": "error",
          "message": {
            "text": "GHSA-stub-0001 in left-pad"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json"
                }
              }
            }
          ],
          "partialFingerprints": {
            "vetFindingId/v1": "f-68be2d562f0682bb"
          },
          "properties": {
            "security-severity": "8.0",
            "tags": [
              "high",
              "vulnerability"
            ],
            "reach": "called · 2 hops"
          }
        },
        {
          "ruleId": "unpinned-action",
          "level": "warning",
          "message": {
            "text": "tj-actions/changed-files@v44 is not pinned to a commit SHA"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 8
                }
              }
            }
          ],
          "partialFingerprints": {
            "vetFindingId/v1": "f-e815bb3b5e0846f1"
          },
          "properties": {
            "security-severity": "5.5",
            "tags": [
              "medium",
              "workflow"
            ]
          }
        },
        {
          "ruleId": "vulnerability",
          "level": "note",
          "message": {
            "text": "GHSA-stub-0002 in left-pad"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json"
                }
              }
            }
          ],
          "partialFingerprints": {
            "vetFindingId/v1": "f-ff61bff9fc367aea"
          },
          "properties": {
            "security-severity": "2.0",
            "tags": [
              "low",
              "vulnerability"
            ],
            "reach": "not called"
          }
        }
      ]
    }
  ]
}
